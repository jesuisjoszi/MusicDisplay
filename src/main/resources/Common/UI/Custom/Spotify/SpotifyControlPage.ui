$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 460);

    #Title {
      Label #PanelTitle {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 18);

      Label #StatusLine {
        Anchor: (Bottom: 14);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #c5cdd6);
        Text: "";
      }

      $C.@TextButton #SetupSpotifyButton {
        Anchor: (Height: 36, Bottom: 8);
        Text: "";
      }

      Group #SetupUrlSection {
        LayoutMode: Top;
        Visible: false;
        Anchor: (Bottom: 12);

        Label #SetupUrlLabel {
          Anchor: (Bottom: 4);
          Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8b95a1, Wrap: true);
          Text: "";
        }

        $C.@TextField #SetupUrlInput {
          Anchor: (Height: 32);
        }
      }

      Label #DisplayLabel {
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8b95a1);
        Text: "";
      }

      Group #HudCheckRow {
        LayoutMode: Left;
        Anchor: (Bottom: 6);
        $C.@CheckBox #HudCheck {}
        Label #HudCheckLabel {
          Text: "";
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          Anchor: (Left: 10);
        }
      }

      Group #ProgressCheckRow {
        LayoutMode: Left;
        Anchor: (Bottom: 6);
        $C.@CheckBox #ProgressCheck {}
        Label #ProgressCheckLabel {
          Text: "";
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          Anchor: (Left: 10);
        }
      }

      Group #AlbumArtCheckRow {
        LayoutMode: Left;
        Anchor: (Bottom: 6);
        $C.@CheckBox #AlbumArtCheck {}
        Label #AlbumArtCheckLabel {
          Text: "";
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          Anchor: (Left: 10);
        }
      }

      Group #TrackNotifyRow {
        LayoutMode: Left;
        Anchor: (Bottom: 12);
        $C.@CheckBox #TrackNotifyCheck {}
        Label #TrackNotifyCheckLabel {
          Text: "";
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          Anchor: (Left: 10);
        }
      }

      Label #PositionLabel {
        Anchor: (Bottom: 6);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8b95a1);
        Text: "";
      }

      Group #PositionButtons {
        LayoutMode: Left;
        Anchor: (Bottom: 10);

        $C.@SecondaryTextButton #PosBottomLeft {
          FlexWeight: 1;
          Anchor: (Right: 4, Height: 30);
          Text: "";
        }

        $C.@SecondaryTextButton #PosBottomRight {
          FlexWeight: 1;
          Anchor: (Right: 4, Height: 30);
          Text: "";
        }

        $C.@SecondaryTextButton #PosTopLeft {
          FlexWeight: 1;
          Anchor: (Right: 4, Height: 30);
          Text: "";
        }

        $C.@SecondaryTextButton #PosTopRight {
          FlexWeight: 1;
          Anchor: (Height: 30);
          Text: "";
        }
      }

      Label #SizeLabel {
        Anchor: (Bottom: 6);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8b95a1);
        Text: "";
      }

      Group #SizeButtons {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        $C.@SecondaryTextButton #SizeSmall {
          FlexWeight: 1;
          Anchor: (Right: 4, Height: 30);
          Text: "";
        }

        $C.@SecondaryTextButton #SizeMedium {
          FlexWeight: 1;
          Anchor: (Right: 4, Height: 30);
          Text: "";
        }

        $C.@SecondaryTextButton #SizeLarge {
          FlexWeight: 1;
          Anchor: (Height: 30);
          Text: "";
        }
      }

      Label #ColorsLabel {
        Anchor: (Bottom: 6);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8b95a1);
        Text: "";
      }

      Group #ColorTrackRow {
        LayoutMode: Left;
        Anchor: (Bottom: 4, Height: 32);
        Label #ColorTrackLabel {
          Anchor: (Width: 70, Top: 6);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #c5cdd6);
          Text: "";
        }
        $C.@TextField #ColorTrackInput {
          FlexWeight: 1;
          Anchor: (Height: 32);
          PlaceholderText: "#e8eaed";
        }
      }

      Group #ColorArtistRow {
        LayoutMode: Left;
        Anchor: (Bottom: 4, Height: 32);
        Label #ColorArtistLabel {
          Anchor: (Width: 70, Top: 6);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #c5cdd6);
          Text: "";
        }
        $C.@TextField #ColorArtistInput {
          FlexWeight: 1;
          Anchor: (Height: 32);
          PlaceholderText: "#9aa0a6";
        }
      }

      Group #ColorTimeRow {
        LayoutMode: Left;
        Anchor: (Bottom: 6, Height: 32);
        Label #ColorTimeLabel {
          Anchor: (Width: 70, Top: 6);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #c5cdd6);
          Text: "";
        }
        $C.@TextField #ColorTimeInput {
          FlexWeight: 1;
          Anchor: (Height: 32);
          PlaceholderText: "#6b7280";
        }
      }

      Group #ColorButtons {
        LayoutMode: Left;
        Anchor: (Bottom: 14);

        $C.@TextButton #ApplyColorsButton {
          FlexWeight: 1;
          Anchor: (Right: 6, Height: 32);
          Text: "";
        }

        $C.@SecondaryTextButton #ResetColorsButton {
          FlexWeight: 1;
          Anchor: (Height: 32);
          Text: "";
        }
      }

      Group #FooterRow {
        LayoutMode: Left;
        Anchor: (Bottom: 0);

        $C.@TextButton #OpenControlsButton {
          FlexWeight: 1;
          Anchor: (Right: 8, Height: 36);
          Text: "";
        }

        $C.@CancelTextButton #CloseButton {
          FlexWeight: 1;
          Anchor: (Height: 36);
          Text: "";
        }
      }
    }
  }
}

$C.@BackButton {}
