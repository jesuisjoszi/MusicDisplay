$C = "../Common.ui";
$S = "../Spotify/SpotifyCommon.ui";

Group #SpotifyHudRoot {
  LayoutMode: Top;
  Anchor: (Bottom: 24, Left: 24, Width: 440);

  Group #SpotifyHudPanel {
    LayoutMode: Top;
    Background: (TexturePath: "../Textures/Spotify/HudPanel.png", HorizontalBorder: 24, VerticalBorder: 20);
    Padding: (Horizontal: 12, Vertical: 10);

    Group #ContentInset {
      LayoutMode: Left;
      Padding: (Horizontal: 6);

      Group #AlbumArtBox {
        LayoutMode: Middle;
        Anchor: (Width: 64, Height: 64, Right: 12);

        AssetImage #AlbumArt {
          Anchor: (Width: 64, Height: 64);
          FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
        }
      }

      Group #TextColumn {
        LayoutMode: Top;
        FlexWeight: 1;
        Anchor: (Height: 64);

        Label #TrackLine {
          Style: $S.@SpotifyTrackStyle;
          Anchor: (Bottom: 2);
          Text: "";
        }

        Label #ArtistLine {
          Style: $S.@SpotifyArtistStyle;
          Anchor: (Bottom: 8);
          Text: "";
        }

        Group #ProgressSection {
          LayoutMode: Top;

          Label #TimeBadge {
            Anchor: (Bottom: 4);
            Style: (...$S.@SpotifyTimeStyle, HorizontalAlignment: End);
            Text: "";
          }

          $S.@SpotifyProgressBar #TrackProgressBar {
            @Anchor = (Left: 0, Right: 0);
            Value: 0.0;
          }
        }
      }
    }
  }
}
